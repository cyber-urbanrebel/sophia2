# Copy to .env and fill in what you have. Every value below is optional —
# Sophia boots and runs fully (auth, habits, journal, shadow work, wisdom
# library, and a grounded AI coach) with nothing filled in at all. The coach
# uses a zero-cost templated reasoning engine and voice runs free in the
# browser (Web Speech API) until real keys are added below.

PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_PATH=./sophia.db
# Leave blank locally. Set this to your managed PostgreSQL connection URL in production.
DATABASE_URL=
JWT_SECRET=change-me-to-a-long-random-string

# --- Optional upgrade: live Claude coaching (falls back to the templated
# coach automatically when this is blank or left as a placeholder) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Optional upgrade: studio-quality server-side voice (falls back to the
# browser's built-in speech recognition/synthesis when these are blank) ---
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
