# SOPHIA Backend Environment Configuration - Local Development

# Server Configuration
NODE_ENV=development
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Database Configuration (SQLite - no external DB needed)
DB_TYPE=sqlite
DB_PATH=./sophia.db

# MongoDB Configuration (optional - will fallback if not available)
MONGODB_URI=mongodb://localhost:27017/sophia_db
MONGODB_DISABLED=true

# Redis Configuration (optional - will fallback if not available)
REDIS_URL=redis://localhost:6379
REDIS_DISABLED=true

# JWT Configuration
JWT_SECRET=sophia-dev-secret-key-2024-change-in-production
JWT_EXPIRE=24h

# Email Configuration (disabled for local dev)
EMAIL_DISABLED=true
EMAIL_FROM=noreply@sophia.ai
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# AI/ML Configuration (Claude API for AI Coach)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=
TENSORFLOW_MODE=development

# Logging
LOG_LEVEL=info

# Security
BCRYPT_ROUNDS=12
SESSION_EXPIRE=86400

# External APIs
CLAUDE_API_KEY=your-anthropic-api-key-here